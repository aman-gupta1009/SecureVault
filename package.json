{
  "name": "securevault",
  "version": "1.0.0",
  "private": true,
  "description": "SecureVault Desktop Application",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND,ELECTRON \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:electron\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:electron": "wait-on tcp:4000 tcp:5173 && electron .",
    "build:frontend": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "concurrently": "^10.0.7",
    "electron": "^45.3.2",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0"
  }
}
