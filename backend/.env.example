# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=secure_vault
DB_USER=your_database_username
DB_PASSWORD=replace_with_your_database_password

# Email OTP - SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=replace_with_your_email_app_password
SMTP_FROM=SecureVault &lt;your_email@example.com&gt;

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Session Configuration
SESSION_TTL_HOURS=24

# Vault Configuration
VAULT_AUTO_LOCK_MINUTES=15
VAULT_ACTIVE_KEY_VERSION=1

# Backup Integrity
BACKUP_MANIFEST_HMAC_KEY=replace_with_a_random_secret
